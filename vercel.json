{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/wedding",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wedding/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/wedding",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/wedding/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/zh/wedding",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/zh/wedding/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/zh-hant/wedding",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/zh-hant/wedding/",
      "destination": "/",
      "permanent": true
    }
  ]
}